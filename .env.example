# =========================================================================
# .env.example - PUBLIC REPOSITORY TEMPLATE (Tracked by Git on GitHub)
# =========================================================================
# This is a safe duplicate/template file for GitHub so anyone cloning the
# repo knows what environment variables are required to run the project.
#
# HOW TO USE:
# 1. Copy this file and rename the copy to '.env' (the main local env file):
#    cp .env.example .env
# 2. Fill in your actual secret keys and configuration values in '.env'.
# 3. Your '.env' file is ignored by Git (.gitignore) and will never be pushed.
# =========================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
MONGO_URI=mongodb+srv://mohangalla2006_db_user:<password>@cluster0.s5bunjq.mongodb.net/twitterclone?retryWrites=true&w=majority

# JWT Authentication Secret Key (Replace with your actual secret in .env)
JWT_SECRET=your_jwt_secret_key_here

# Frontend Client Configuration
# In Production, points to live Render backend: https://xclone-di8o.onrender.com
VITE_API_URL=https://xclone-di8o.onrender.com/api
VITE_API_BASE_URL=https://xclone-di8o.onrender.com
